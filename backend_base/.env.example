NODE_ENV=development
PORT=3000
SERVICE_NAME=first microservice
URL_DB=postgresql://postgres:password@localhost:5432/backend_for_students
DB_SSL=true
# Obligatorio, mínimo 32 caracteres. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Orígenes permitidos para el frontend, separados por comas
CORS_ORIGINS=http://localhost:5173
